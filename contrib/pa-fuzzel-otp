#!/bin/sh
#
# prompt for otp code via fuzzel
# then type the selected password via wtype
# put otp secrets in 'otp/' category

for dependency in fuzzel oathtool wtype; do
  command -v $dependency >/dev/null || { printf '%s not found' "$dependency"; exit 1; }
done

pa show $(pa list otp | fuzzel --dmenu "$@") \
  | head --lines 1 | oathtool --base32 --totp - | tr --delete '\n' | wtype -
